<h1 class="logo_font_primary text-center" style="font-weight: bold;">Signin</h1>
<form method="post" action="/signin">
    <div class="container text-center">
        <div class="row flex-row align-items-center">
            <div class="form-group">
                <label class="tag_content" style="font-size: clamp(13px, 1.5vw, 28.08px);" for="email">Email:</label>
                <input type="email" name="email" class="form-control input_col" required>
            </div>
            <div class="form-group">
                <label class="tag_content" style="font-size: clamp(13px, 1.5vw, 28.08px);" for="password">Password:</label>
                <input type="password" name="password" class="form-control input_col" required>
            </div>
        </div>
        <div class="row" >
            <div class="d-flex justify-content-center" >
                <a class="tag accent2_primary" href="/signin/google" style="font-size: clamp(15.84px, 2vw, 37.44px);">
                    <i class="bi bi-google"></i>
                    Use Google Account
                </a>
            </div>
        </div>
        <div class="row align-items-center">
            <div style="margin-top:clamp(23.76px, 3vw, 56.16px)">
                <button type="submit" class="cart_btn p-2" style="margin-left: clamp(15.84px, 2vw, 37.44px);">Signin</button>
            </div>
        </div>
    </div>
</form>