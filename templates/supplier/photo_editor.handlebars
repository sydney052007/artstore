{{> supplier/area_buttons mode="products"}}
<div class="row ">
    <div class="row align-items-center justify-content-center ">
        <img src="/pics/colorpencil/{{photo_data.categoryName}}/{{photo_data.photo_URL}}" class="img"  style="border-radius: 2rem;width: 60%;">
    </div>
    <div class="row align-items-center" >
        <form action="/supplier/photo/upload" method="POST" enctype="multipart/form-data">
            <div class="form-group avatar">
                <label for="avatar" class="file">select your photo</label>
                <input type="file" name="avatar" id="avatar" >
                <span id="file-name" class="file-name tag" style="margin-top: 1.5vw;">No file selected</span>
                <button type="submit" class="button" style="margin-top: 3vw;">upload</button>
            </div>
            
        </form>
    </div>
</div>

