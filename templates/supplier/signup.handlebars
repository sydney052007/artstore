<!DOCTYPE html>
<html>
    <head>
        <script src = "/bundle.js" defer></script>
        <link href="/style.css" rel="stylesheet">
        <link href="/css/bootstrap.min.css" rel="stylesheet"/>
        <link href="/font/bootstrap-icons.min.css" rel="stylesheet"/>
        {{#if (isDevelopment)}}
            <script src="/admin/bundle.js"></script>
        {{/if}}
    </head>
    <body>
        <h1 class="logo_font_primary text-center" style="font-weight: bold;margin-top:5vw">Signup</h1>
            <form method="post" action="/supplier/signup">
                <div class="text-center">
                    <div class="row flex-row align-items-center justify-content-center">
                        <div class="m-2">
                            <h1 class="card_title" style="font-size: 2vw;">Your account:</h1>
                            <div class="form-group">
                                <label class="tag_content" style="font-size: 1.5vw;">Name:</label>
                                    <input name="supplier[name]" id="name" class="form-control input_col" value="{{ value }}">
                                    {{#if invalid }}
                                        {{> validation_messages message }}
                                    {{/if }}
                            </div>
                            <div class="form-group">
                                <label class="tag_content" style="font-size: 1.5vw;">Email:</label>
                                    <input name="supplier[email]" id="email" class="form-control input_col" value="{{ value }}">
                                    {{#if invalid}}
                                        {{> validation_messages message }}
                                    {{/if}}
                            </div>
                        <div class="form-group">
                            <label class="tag_content" style="font-size: 1.5vw;">Password:</label>
                                <input type="password"  name="supplier[password]" id="password" class="form-control input_col">
                        </div>
                    </div>
                    <div class="row mt-4">
                        <div class="d-flex justify-content-center">
                            <a class="tag accent2_primary" href="/supplier/signup/google" style="font-size: 2vw;">
                                <i class="bi bi-google"></i>
                                Use Google Account
                            </a>
                        </div>
                    </div>
                    <input type="hidden" name="identity" value="customer">
                    <div class="row align-items-center">
                        <div style="padding: 2vw;margin-top:3vw">
                            <button type="submit" class="cart_btn p-2" style="margin-left: 2vw;">Signup</button>
                        </div>
                    </div>
                </div>
            </form>
            <div class="row" style="margin-top: 3vw;">
                <a href="/supplier/signin" class="button">already have an account? please signin</a>
            </div>
    </body>
</html>
