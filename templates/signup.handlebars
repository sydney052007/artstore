<h1 class="logo_font_primary text-center" style="font-weight: bold;">Signup</h1>
<form method="post" action="/signup">
    <div class="text-center">
        <div class="row flex-row align-items-center justify-content-center">
            <div>{{> order_details_customer }}</div>
            <div class="form-group">
                <label class="tag_content" style="font-size: 1.5vw;">Password:</label>
                    <input type="password"  name="customer[password]" id="password" class="form-control input_col">
            </div>
        </div>
        <div class="row mt-4">
            <div class="d-flex justify-content-center">
                <a class="tag accent2_primary" href="/signup/google" style="font-size: 2vw;">
                    <i class="bi bi-google"></i>
                    Use Google Account
                </a>
            </div>
        </div>
        <input type="hidden" name="identity" value="customer">
        <div class="row align-items-center">
            <div style="padding: 2vw;margin-top:3vw">
                <button type="submit" class="cart_btn p-2" style="margin-left: 2vw;">Signup</button>
            </div>
        </div>
    </div>
</form>
<div class="row" style="margin-top: 3vw;">
    <a href="/signin" class="button">already have an account? please signin</a>
</div>
