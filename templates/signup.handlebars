<h1 class="logo_font_primary text-center" style="font-weight: bold;">Signup</h1>
<form method="post" action="/signup">
    <div class="text-center">
        <div class="row flex-row align-items-center justify-content-center">
            <div>{{> order_details_customer }}</div>
            <div class="form-group">
                <label class="tag_content" style="font-size: clamp(13px, 1.5vw, 28.08px);">Password:</label>
                    <input type="password"  name="customer[password]" id="password" class="form-control input_col">
            </div>
        </div>
        <div class="row mt-4">
            <div class="d-flex justify-content-center">
                <a class="tag accent2_primary" href="/signup/google" style="font-size: clamp(15.84px, 2vw, 37.44px);">
                    <i class="bi bi-google"></i>
                    Use Google Account
                </a>
            </div>
        </div>
        <input type="hidden" name="identity" value="customer">
        <div class="row align-items-center">
            <div style="padding: clamp(15.84px, 2vw, 37.44px);margin-top:clamp(23.76px, 3vw, 56.16px)">
                <button type="submit" class="cart_btn p-2" style="margin-left: clamp(15.84px, 2vw, 37.44px);">Signup</button>
            </div>
        </div>
    </div>
</form>
<div class="row" style="margin-top: clamp(23.76px, 3vw, 56.16px);">
    <a href="/signin" class="button">already have an account? please signin</a>
</div>
