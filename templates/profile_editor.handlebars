<div class="row">
    <form class="text-center items-align-center" action="/edit_profile" method="post" >
        <div class="form-group">
            <label class="card_title" for="name">Name:</label>
            <input type="text" class="input_col" name="name" value="{{user.name}}" required>
        </div>
        <div class="form-group">
            <label class="card_title" for="email">Email:</label>
            <input type="email" class="input_col" name="email" value="{{user.email}}" required>
        </div>
        <div class="form-group">
            <label class="card_title" for="password">Password:</label>
            <input type="password" class="input_col" name="password">
        </div>
        <a href="/signup" class="button" style="margin-right:4vw;"> <i class="bi bi-chevron-double-left" ></i>back</a>
        <button type="submit" class="button" style="margin-top: 3vw;margin-left:4vw">update profile</button>
        
    </form>
</div>
