<div class="mb-2 form-group">
    <label class="card_title">{{ label }}</label>
    <select name="{{name}}" class="input_col" style="border-bottom: 0;">
        <option value="" disabled selected>Choose {{label}}</option>
        {{#each list}}
            <option {{ selected id ../data.value }} value="{{id}}">{{ name }}</option>
        {{/each}}
    </select>
    {{> admin/validation_messages data}}
</div>