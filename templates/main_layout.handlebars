<!DOCTYPE html>
<html>
    <head>
        <script src = "/bundle.js?v={{assetVersion}}" defer></script>
        <link href="/style.css?v={{assetVersion}}" rel="stylesheet">
        <link href="/css/bootstrap.min.css" rel="stylesheet"/>
        <link href="/font/bootstrap-icons.min.css" rel="stylesheet"/>
        <link href="/dist/flatpickr.min.css" rel="stylesheet"/>
        <script src="/js/bootstrap.bundle.min.js" defer></script>
    </head>
    <body>
        <div class="py-2 px-1">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-auto text-center">
                        <a class="btn btn-sm navbar-btn" href="/">
                            <i class="bi bi-house-fill secondary_color button" style="font-size: clamp(31.68px, 4vw, 74.88px);"></i>
                        </a>
                        {{#if show_categories}}
                        <button class="btn btn-sm navbar-btn d-md-none d-block mx-auto p-0" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#categorySidebar" aria-controls="categorySidebar" aria-label="Categories">
                            <i class="bi bi-list secondary_color button" style="font-size: clamp(24px, 3.2vw, 42px);"></i>
                        </button>
                        {{/if}}
                    </div>
                    <div class="col align-baseline pt-1 text-center" style="margin-right: clamp(0px, 0vw, 0px);">
                        <a href="/home" style="text-decoration: none;">
                        <div class="logo_font_secondary d-inline">if(</div>
                        <div class="logo_font_primary d-inline"> RENT</div>
                        <div class="logo_font_secondary d-inline">|</div>
                        <div class="logo_font_primary d-inline"> BUY</div>
                        <div class="logo_font_secondary d-inline">)</div>
                        </a>
                        </div>
                    <div class="col-auto text-end secondary_color" style="margin-top: clamp(6.34px, 0.8vw, 14.98px);">
                        {{#if show_cart}}
                            {{> cart_summary}}
                        {{/if}}
                        <a class="btn btn-sm navbar-btn "
                            href="/signup">
                            <i class="bi bi-person-bounding-box secondary_color button" style="font-size: clamp(31.68px, 4vw, 74.88px);"></i>
                        </a> 
                    </div>
                </div>
            </div>
        </div> 
        {{{ body }}}
    </body>
</html>